@page "/etrn"
@rendermode InteractiveServer

<div class="page-head"><h3>ЭтРН</h3></div>
<div class="panel" style="max-width:640px">
    <div class="row">
        <input @bind="num" placeholder="Номер ЭтРН" style="flex:1" />
        <input @bind="date" placeholder="Дата" />
        <button class="btn" @onclick="Add">Добавить</button>
    </div>
    <div class="mt">
        @foreach (var d in Docs)
        {
            <div class="card"><b>@d</b></div>
        }
    </div>
</div>

@code {
    string num = "", date = "";
    static List<string> Docs = new();
    void Add()
    {
        if (!string.IsNullOrWhiteSpace(num))
        {
            Docs.Insert(0, num.Trim() + " от " + date);
            num = ""; date = "";
        }
    }
}