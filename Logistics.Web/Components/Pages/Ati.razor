    private void OpenOffer(AtiBoardCargo c, AtiOffer? existing = null)
    {
        confirmSendOfferId = null;

        offerCargoId = c.Id;
        raw = "";

        offerDraft = new AtiOfferDraft { ContactId = account?.CurrentContactId ?? 0 };

        if (existing == null)
        {
            offerDraft.LoadingDate = c.FirstDate >= DateTime.Today ? c.FirstDate : DateTime.Today;
            return;
        }

        offerDraft.NdsPrice = existing.NdsPrice > 0 ? existing.NdsPrice : null;
        offerDraft.NdsPercent = existing.NdsPercent > 0 ? (int)existing.NdsPercent : 22;
        offerDraft.NotNdsPrice = existing.NotNdsPrice > 0 ? existing.NotNdsPrice : null;
        offerDraft.Price = existing.Price > 0 ? existing.Price : null;
        offerDraft.LoadingDate = existing.LoadingDate;
        offerDraft.Note = existing.Note;
    }

