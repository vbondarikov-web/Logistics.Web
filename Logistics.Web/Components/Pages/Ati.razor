    @if (tab == "archive")
    {
        <div>
            <button class="ati-btn" disabled="@busy" @onclick="() => Run(LoadArchive)">@(archiveLoaded ? "Обновить архив" : "Загрузить архив")</button>
            <button class="ati-btn primary" disabled="@(busy || archiveSel.Count == 0)" @onclick="() => Run(RestoreSelected)">
                Восстановить выбранные (@archiveSel.Count)
            </button>
            @if (confirmDeleteMany)
            {
                <span class="ati-muted">Удалить @archiveSel.Count грузов навсегда?</span>
                <button class="ati-btn" disabled="@busy" @onclick="() => Run(DeleteSelected)">Да, удалить</button>
                <button class="ati-btn" @onclick="() => confirmDeleteMany = false">Отмена</button>
            }
            else
            {
                <button class="ati-btn" disabled="@(busy || archiveSel.Count == 0)" @onclick="() => confirmDeleteMany = true">Удалить выбранные</button>
            }
            <button class="ati-btn" disabled="@busy" @onclick="() => Run(LoadArchiveOffers)">Предложения на архивные грузы</button>
        </div>

        @if (archiveLoaded && archived.Count == 0)
        {
            <p class="ati-muted">Архив пуст.</p>
