                </div>
                <div class="main">
                    <div class="ati-route">
                        @Svc.CityName(l.LoadingCityId) → @Svc.CityName(l.UnloadingCityId)
                        @if (l.Distance > 0)
                        {
                            <span class="ati-muted">@l.Distance км</span>
                        }
                    </div>
                    <div>
                        @l.CargoName
                        @if (l.Weight > 0)
                        {
                            <span> · @l.Weight.ToString("0.###") т</span>
                        }
                        @if (l.Volume > 0)
                        {
                            <span> · @l.Volume.ToString("0.###") м³</span>
                        }
                        @if (Svc.BodyNames(l.CarTypeMask).Length > 0)
                        {
                            <span> · @Svc.BodyNames(l.CarTypeMask)</span>
                        }
                    </div>
                    <div><span class="ati-rate">@RateText(l)</span> · @DateText(l)</div>
                    <div class="ati-muted">
                        № @l.Number
                        @if (l.ArchiveDate != null)
                        {
                            <span> · в архиве с @l.ArchiveDate.Value.ToString("dd.MM HH:mm")</span>
                        }
                        @if (l.ArchiveReason.Length > 0 && l.ArchiveReason != "Unknown")
                        {
                            <span> · причина: @l.ArchiveReason</span>
                        }
                        @if (l.OfferCount > 0)
                        {
                            <span> · предложений: @l.OfferCount</span>
                        }
                    </div>
                    @if (l.Note.Length > 0)
                    {
                        <div class="ati-muted">@l.Note</div>
                    }
                    @if (l.BoardIds.Count > 0)
                    {
                        <div class="ati-muted">Площадки: @Svc.BoardNames(l.BoardIds)</div>
                    }
                    @if (archiveComments.TryGetValue(l.Id, out var cms))
                    {
                        @foreach (var c in cms)
                        {
                            <div class="ati-muted">
                                Комментарий: @c.Message
                                @if (c.Date != null)
                                {
                                    <span> · @c.Date.Value.ToString("dd.MM HH:mm")</span>
                                }
                            </div>
                        }
                    }
                    @if (restoreErrors.TryGetValue(l.Id, out var rsErr))
                    {
                        <div class="ati-muted" style="color:#fca5a5">Не восстановлен: @rsErr</div>
                    }
                    @if (deleteErrors.TryGetValue(l.Id, out var delErr))
                    {
                        <div class="ati-muted" style="color:#fca5a5">Не удалён: @delErr</div>
                    }
                    <div class="ati-actions">
                        @if (confirmDeleteId == l.Id)
                        {
                            <span class="ati-muted">Удалить навсегда? Отменить будет нельзя.</span>
                            <button disabled="@busy" @onclick="() => Run(() => DeleteOne(l))">Да, удалить</button>
                            <button @onclick="() => confirmDeleteId = null">Отмена</button>
                        }
                        else
                        {
                            <button disabled="@(busy || !l.CanBeRestored)" @onclick="() => Run(() => RestoreOne(l))">Восстановить</button>
                            <button disabled="@busy" @onclick="() => Run(() => OpenDraft(l, false))">Копировать</button>
                            <button disabled="@busy" @onclick="() => confirmDeleteId = l.Id">Удалить навсегда</button>
                        }
                    </div>
                </div>
            </div>
        }

        @if (archiveOffersLoaded)
        {
            <h4 class="ati-muted" style="margin-top:18px">Предложения на архивные грузы (за 30 дней)</h4>
            @if (archiveOffers.Count == 0)
            {
                <p class="ati-muted">Предложений нет.</p>
            }
        }

        @foreach (var o in archiveOffers)
        {
            var load = archived.FirstOrDefault(x => x.Id == o.CargoId);

            <div class="ati-card">
                <div class="main">
                    <div class="ati-route">
                        @o.FirmName
                        @if (o.Score > 0)
                        {
                            <span class="ati-muted">★ @o.Score.ToString("0.#")</span>
                        }
                    </div>
                    <div><span class="ati-rate">@OfferRateText(o)</span></div>
                    <div class="ati-muted">
                        Груз № @o.CargoNumber
                        @if (load != null)
                        {
                            <span> · @Svc.CityName(load.LoadingCityId) → @Svc.CityName(load.UnloadingCityId)</span>
                        }
                        @if (o.AddedAt != null)
                        {
                            <span> · получено @o.AddedAt.Value.ToString("dd.MM HH:mm")</span>
                        }
                    </div>
                    @if (o.ContactName.Length > 0 || o.Phone.Length > 0)
                    {
                        <div>
                            @o.ContactName
                            @if (o.Phone.Length > 0)
                            {
                                <a href="tel:@o.Phone" style="color:#34d399; margin-left:8px">@o.Phone</a>
                            }
                        </div>
                    }
                    @if (o.Note.Length > 0)
                    {
                        <div class="ati-muted">@o.Note</div>
                    }
                </div>
            </div>
        }
    }

    @if (raw.Length > 0 && tab != "list" && tab != "orders")
    {
        <pre class="ati-raw">@raw</pre>
    }

@code {
    private static readonly JsonSerializerOptions PrettyJson = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private static readonly string[] DocTypes =
    {
        "заказ",
        "заказ (табличный вид)",
        "заявка (к договору)",
        "заявка к договору (табличный вид)",
        "поручение экспедитору"
    };

    private string tab = "list";
    private bool busy;
    private string msg = "";
    private bool msgError;
    private string raw = "";
    private string docUrl = "";
    private string docType = "заказ";

    private AtiAccount? account;
    private List<AtiCarType> carTypes = new();
    private List<AtiLoad> loads = new();
    private readonly HashSet<string> selected = new();
    private Dictionary<string, string> refreshErrors = new();

    private List<AtiLoad> archived = new();
    private bool archiveLoaded;
    private readonly HashSet<string> archiveSel = new();
    private Dictionary<string, string> restoreErrors = new();
    private Dictionary<string, string> deleteErrors = new();
    private Dictionary<string, List<AtiLoadComment>> archiveComments = new();
    private List<AtiOffer> archiveOffers = new();
    private bool archiveOffersLoaded;
    private string? confirmDeleteId;
    private bool confirmDeleteMany;

    private AtiCargoDraft draft = new();
    public HashSet<int> BodyLoadingTypeIds { get; set; } = new();
    public HashSet<int> BodyUnloadingTypeIds { get; set; } = new();

    public bool IsAllBodyLoadingRequired { get; set; }
    public bool IsAllBodyUnloadingRequired { get; set; }
    private string? editId;
    private string editNumber = "";

    private string loadQuery = "";
    private string unloadQuery = "";
    private List<AtiCitySuggestion> loadSug = new();
    private List<AtiCitySuggestion> unloadSug = new();
    private string boardIdsText = "";

    private List<AtiBoard> boards = new();
    private string boardsError = "";
    private readonly HashSet<string> boardSearchSel = new();

    private List<AtiOffer> offers = new();
    private bool offersLoaded;
    private string? confirmOfferId;
    private string? confirmArchiveId;

    private List<AtiBoardCargo> boardCargos = new();
    private List<string> boardSearchIds = new();
    private int boardTotal;
    private int boardSkip;
    private bool boardSearched;

    private string? offerCargoId;
    private AtiOfferDraft offerDraft = new();
    private readonly Dictionary<string, AtiOffer> myOffers = new();
    private HashSet<string> activeOfferCargoIds = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Svc.IsConfigured) return;

        await Run(async () =>
        {
            carTypes = await Svc.GetCarTypesAsync();
            account = await Svc.GetAccountAsync();
            draft.ContactId = account.CurrentContactId;
            await LoadBoards();
            await LoadCargos();
            await LoadHandlingOptionsAsync();
            await LoadCargoNamesAsync();
        });
    }

    private async Task Run(Func<Task> action)
    {
        busy = true;
        msg = "";
        msgError = false;
        docUrl = "";

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            msg = ex.Message;
            msgError = true;
        }
        finally
        {
            busy = false;
        }
    }

    // ---------- Площадки ----------

    private async Task LoadBoards()
    {
        try
        {
            boards = await Svc.GetBoardsAsync();
            boardsError = "";
        }
        catch (Exception ex)
        {
            boards = new List<AtiBoard>();
            boardsError = ex.Message;
        }
    }

    private void ToggleDraftBoard(string id, bool on)
    {
        if (on)
        {
            if (!draft.BoardIds.Contains(id)) draft.BoardIds.Add(id);
        }
        else
        {
            draft.BoardIds.Remove(id);
        }
    }

    private void ToggleSearchBoard(string id, bool on)
    {
        if (on) boardSearchSel.Add(id);
        else boardSearchSel.Remove(id);
    }

    private async Task LoadHandlingOptionsAsync()
    {
        try
        {
            handlingOptions = await Svc.GetHandlingTypesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Справочник способов не загружен: {ex.Message}");
        }
    }


    // ---------- Мои грузы ----------
    private string loadContactFilter = "";

    private IEnumerable<AtiLoad> FilteredLoads =>
        int.TryParse(loadContactFilter, out var contactId)
            ? loads.Where(l => l.ContactId == contactId)
            : loads;

    private string LoadContactName(int contactId)
    {
        if (contactId <= 0)
            return "Не указан";

        var contact = account?.Contacts.FirstOrDefault(c => c.Id == contactId);

        return string.IsNullOrWhiteSpace(contact?.Name)
            ? $"Контакт № {contactId}"
            : contact!.Name;
    }

    private async Task RefreshOne(AtiLoad load)
    {
        if (!load.CanBeRenewed)
            return;

        if (Svc.IsDryRun)
        {
            msg = "DryRun: запрос на поднятие не отправлен.";
            return;
        }

        var result = await Svc.RefreshCargosAsync(new[] { load.Id });

        if (!result.TryGetValue(load.Id, out var error))
            error = "Нет ответа ATI по грузу.";

        if (!string.IsNullOrEmpty(error))
        {
            refreshErrors[load.Id] = error;
            msg = $"Груз № {load.Number} не поднят: {error}";
            msgError = true;
            return;
        }

        refreshErrors.Remove(load.Id);
        selected.Remove(load.Id);
        await LoadCargos();
        msg = $"Груз № {load.Number} поднят в ТОП.";
    }

    private async Task LoadCargos()
    {
        loads = await Svc.GetMyCargosAsync();
        selected.IntersectWith(loads.Where(l => l.CanBeRenewed).Select(l => l.Id));
    }

    private void Toggle(string id, bool on)
    {
        if (on) selected.Add(id);
        else selected.Remove(id);
    }

    private async Task RefreshSelected()
    {
        var result = await Svc.RefreshCargosAsync(selected);
        var ok = result.Count(r => r.Value.Length == 0);

        refreshErrors = result.Where(r => r.Value.Length > 0)
                              .ToDictionary(r => r.Key, r => r.Value);
        selected.Clear();

        if (!Svc.IsDryRun) await LoadCargos();

        msg = "Поднято: " + ok + " из " + result.Count +
              (refreshErrors.Count > 0 ? ". Причины отказа указаны в карточках." : ".");
        msgError = ok == 0;
    }

    private async Task ArchiveLoad(AtiLoad l)
    {
        confirmArchiveId = null;

        var result = await Svc.ArchiveCargosAsync(new[] { l.Id });

        if (Svc.IsDryRun)
        {
            msg = "DryRun: запрос на архивацию не отправлен.";
            return;
        }

        if (result.TryGetValue(l.Id, out var err) && err.Length > 0)
        {
            throw new InvalidOperationException("ATI не отправил груз в архив: " + err);
        }

        selected.Remove(l.Id);
        await LoadCargos();
        msg = "Груз № " + l.Number + " отправлен в архив.";
    }

    private async Task CreateAtiDoc(AtiLoad l)
    {
        if (Svc.IsDryRun)
        {
            msg = "DryRun: документ не создан.";
            return;
        }

        var result = await Svc.CreateAtiDocAsync(l.Id, docType);
        docUrl = result.Url;
        msg = "Документ «" + docType + "» по грузу № " + l.Number + " создан в АТИ-Доках.";
    }

    private async Task OpenDraft(AtiLoad l, bool edit)
    {
        draft = await Svc.GetCargoDraftAsync(l.Id);

        if (draft.ContactId == 0 && account != null) draft.ContactId = account.CurrentContactId;

        if (edit)
        {
            editId = l.Id;
            editNumber = l.Number;
        }
        else
        {
            editId = null;
            editNumber = "";
            draft.CargoId = 0;
        }

        loadQuery = draft.LoadingCityName;
        unloadQuery = draft.UnloadingCityName;
        loadSug.Clear();
        unloadSug.Clear();
        raw = "";
        tab = "form";
    }

    private static string RateText(AtiLoad l)
    {
        if (!l.FixedRate) return "Запрос ставки";

        var parts = new List<string>();
        if (l.SumWithNds > 0) parts.Add(l.SumWithNds.ToString("N0") + " с НДС");
        if (l.SumWithoutNds > 0) parts.Add(l.SumWithoutNds.ToString("N0") + " без НДС");
        if (l.RateSum > 0) parts.Add(l.RateSum.ToString("N0") + " нал");
        if (parts.Count == 0) return "Ставка не указана";

        return string.Join(" / ", parts) + (l.Torg ? " (торг)" : "");
    }

    private static string DateText(AtiLoad l)
    {
        switch (l.DateType)
        {
            case 0: return "готов к загрузке";
            case 2: return "постоянно";
            case 3: return "груза нет, запрос ставки";
        }

        if (l.FirstDate == null) return "";

        var text = l.FirstDate.Value.ToString("dd.MM");
        if (l.LastDate != null && l.LastDate != l.FirstDate)
        {
            text += "–" + l.LastDate.Value.ToString("dd.MM");
        }

        return text;
    }

    // ---------- Поиск транспорта ----------

    private string? truckCargoId;
    private bool truckDemo = true;
    private bool truckLastSearchWasDemo;
    private bool truckSearchCompleted;
    private int truckTotal;
    private int truckHidden;
    private List<AtiService.TruckSearchItem> truckItems = new();

    private async Task FindTrucks(AtiLoad load)
    {
        truckCargoId = load.Id;
        truckSearchCompleted = false;
        truckItems.Clear();

        var demo = truckDemo || Svc.IsDryRun;
        var result = await Svc.SearchTrucksAsync(load, demo);
        truckItems = result.Items;
        truckTotal = result.Total;
        truckHidden = result.Hidden;
        truckLastSearchWasDemo = demo;
        truckSearchCompleted = true;
    }

    // ---------- Архив ----------

    private async Task LoadArchive()
    {
        raw = "";
        confirmDeleteId = null;
        confirmDeleteMany = false;

        archived = await Svc.GetArchivedCargosAsync();
        archiveLoaded = true;
        archiveSel.IntersectWith(archived.Select(l => l.Id));

        try
        {
            archiveComments = await Svc.GetArchiveCommentsAsync();
        }
        catch (Exception ex)
        {
            archiveComments = new();
            msg = "Архив загружен, но комментарии не получены: " + ex.Message;
            msgError = true;
        }
    }

    private void ToggleArchive(string id, bool on)
    {
        if (on) archiveSel.Add(id);
        else archiveSel.Remove(id);
    }

    private Task RestoreSelected()
        => RestoreMany(archived.Where(l => archiveSel.Contains(l.Id) && l.CanBeRestored).Select(l => l.Id).ToList());

    private Task RestoreOne(AtiLoad l) => RestoreMany(new[] { l.Id });

    private async Task RestoreMany(IEnumerable<string> ids)
    {
        var result = await Svc.RestoreCargosAsync(ids);
        var ok = result.Count(r => r.Value.Length == 0);

        restoreErrors = result.Where(r => r.Value.Length > 0)
                              .ToDictionary(r => r.Key, r => r.Value);
        archiveSel.Clear();

        if (Svc.IsDryRun)
        {
            msg = "DryRun: запрос на восстановление не отправлен.";
            return;
        }

        await LoadArchive();
        await LoadCargos();

        msg = "Восстановлено: " + ok + " из " + result.Count +
              (restoreErrors.Count > 0 ? ". Причины отказа указаны в карточках." : ".");
        msgError = ok == 0;
    }

    private Task DeleteSelected() => DeleteMany(archiveSel.ToList());

    private Task DeleteOne(AtiLoad l) => DeleteMany(new[] { l.Id });

    private async Task DeleteMany(IEnumerable<string> ids)
    {
        confirmDeleteId = null;
        confirmDeleteMany = false;

        var result = await Svc.DeleteArchivedCargosAsync(ids);
        var ok = result.Count(r => r.Value.Length == 0);

        deleteErrors = result.Where(r => r.Value.Length > 0)
                             .ToDictionary(r => r.Key, r => r.Value);
        archiveSel.Clear();

        if (Svc.IsDryRun)
        {
            msg = "DryRun: запрос на удаление не отправлен.";
            return;
        }

        await LoadArchive();

        msg = "Удалено: " + ok + " из " + result.Count +
              (deleteErrors.Count > 0 ? ". Причины отказа указаны в карточках." : ".");
        msgError = ok == 0;
    }

    private async Task LoadArchiveOffers()
    {
        raw = "";
        archiveOffers = await Svc.GetUnpublishedCounterOffersAsync();
        archiveOffersLoaded = true;
    }

    // ---------- Форма ----------

    private async Task SearchCity(bool loading, string? text)
    {
        text ??= "";

        if (loading)
        {
            loadQuery = text;
            draft.LoadingCityId = 0;
        }
        else
        {
            unloadQuery = text;
            draft.UnloadingCityId = 0;
        }

        if (text.Trim().Length < 2)
        {
            if (loading) loadSug.Clear();
            else unloadSug.Clear();
            return;
        }

        try
        {
            var found = await Svc.SearchCitiesAsync(text);

            // ответ на устаревший ввод не показываем
            if (loading && loadQuery == text) loadSug = found;
            if (!loading && unloadQuery == text) unloadSug = found;
        }
        catch (Exception ex)
        {
            msg = ex.Message;
            msgError = true;
        }
    }

    private void PickCity(bool loading, AtiCitySuggestion s)
    {
        if (loading)
        {
            draft.LoadingCityId = s.CityId;
            draft.LoadingRegionId = s.RegionId;
            if (s.CountryId > 0) draft.LoadingCountryId = s.CountryId;
            draft.LoadingCityName = s.Name;
            loadQuery = s.Address;
            loadSug.Clear();
        }
        else
        {
            draft.UnloadingCityId = s.CityId;
            draft.UnloadingRegionId = s.RegionId;
            if (s.CountryId > 0) draft.UnloadingCountryId = s.CountryId;
            draft.UnloadingCityName = s.Name;
            unloadQuery = s.Address;
            unloadSug.Clear();
        }
    }

    private void Preview()
    {
        var problems = AtiService.Validate(draft);
        raw = Svc.PreviewJson(draft);
        msg = problems.Count == 0 ? "Ошибок в форме нет." : "• " + string.Join("\n• ", problems);
        msgError = problems.Count > 0;
    }

    private async Task Submit()
    {
        var editing = editId != null;

        var answer = editing
            ? await Svc.UpdateCargoAsync(editId!, draft)
            : await Svc.CreateCargoAsync(draft);

        if (Svc.IsDryRun)
        {
            raw = answer;
            msg = "DryRun: запрос не отправлен, тело показано ниже.";
            return;
        }

        ResetForm();
        loadingMethods.Clear();
        unloadingMethods.Clear();
        await LoadCargos();
        tab = "list";
        msg = editing ? "Изменения сохранены." : "Груз опубликован.";
    }

    private void ToggleBodyType(int id, bool isChecked)
    {
        if (isChecked)
        {
            if (!draft.BodyTypeIds.Contains(id))
                draft.BodyTypeIds.Add(id);
        }
        else
        {
            draft.BodyTypeIds.Remove(id);
        }
    }

    private static readonly string[] CargoNames = (
        "Автомобиль(ли)|Автошины|Алкогольные напитки|Арматура|Балки надрессорные|" +
        "Безалкогольные напитки|Боковая рама|Бумага|Бытовая техника|Бытовая химия|" +
        "Вагонка|Газосиликатные блоки|Гипс|Гофрокартон|Грибы|ДВП|ДСП|Двери|" +
        "Домашний переезд|Доски|Древесина|Древесный уголь|Ж/д запчасти (прочие)|ЖБИ|" +
        "Животные|Зерно и семена (в упаковке)|Зерно и семена (насыпью)|Игрушки|" +
