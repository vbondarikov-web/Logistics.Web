    private static string FormatOrderRate(string? text)
    {
        var invariant = System.Globalization.CultureInfo.InvariantCulture;

        if (!decimal.TryParse(text, System.Globalization.NumberStyles.Float,
                              invariant, out var amount))
            return text ?? "—";

        var ru = System.Globalization.CultureInfo.GetCultureInfo("ru-RU");
        return amount.ToString("#,0.############################", ru);
    }

private static string OrderRates(JsonElement deal)
{
    var rates = OrderField(OrderField(deal, "payment"), "rates");

    if (rates.ValueKind != JsonValueKind.Array)
    {
        return "—";
    }

    var activeRates = new System.Collections.Generic.List<string>();

    foreach (var rate in rates.EnumerateArray())
    {
        if (OrderField(rate, "active").ValueKind != JsonValueKind.True
            || OrderText(rate, "rate") is not { } amount)
        {
            continue;
        }
            var formattedAmount = FormatOrderRate(amount);
            var currency = OrderText(rate, "currency");
            activeRates.Add(currency is null
                ? formattedAmount
                : $"{formattedAmount} (код валюты: {currency})");
    }

    return activeRates.Count == 0 ? "—" : string.Join("; ", activeRates);
}

