@page "/ati"
@using System.Text.Json
@using Logistics.Web.Models
@using Logistics.Web.Services
@inject AtiService Svc

<style>
    .ati-sec .atw-row,
    .ati-sec ~ .atw-row {
        max-width: 100%;
    }

    .ati-vehicle-wrap,
    .ati-cargo-machine {
        max-width: 100%;
        overflow: hidden;
    }

    .ati-sec {
        max-width: 760px;
    }

    .atw-row {
        max-width: 760px;
    }

    .atw-tags {
        max-width: 760px;
    }

    .ati-tabs {
        margin: 14px 0;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

        .ati-tabs button {
            padding: 8px 18px;
            border: 1px solid rgba(255,255,255,.15);
            background: rgba(255,255,255,.06);
            color: #cfe3e0;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }

            .ati-tabs button:hover {
                background: rgba(255,255,255,.12);
            }

            .ati-tabs button.on {
                background: #10b981;
                border-color: #10b981;
                color: #fff;
            }

    .ati-msg {
        margin: 12px 0;
        padding: 10px 14px;
        border-radius: 8px;
        white-space: pre-wrap;
        background: rgba(16,185,129,.15);
        border: 1px solid rgba(16,185,129,.4);
        color: #d1fae5;
    }

        .ati-msg.err {
            background: rgba(239,68,68,.15);
            border-color: rgba(239,68,68,.45);
            color: #fecaca;
        }

        .ati-msg a {
            color: #34d399;
            margin-left: 8px;
        }

    .ati-card {
        display: flex;
        gap: 14px;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 12px;
        background: rgba(255,255,255,.05);
        color: #e6f1f0;
        max-width: 1000px;
    }

        .ati-card:hover {
            border-color: rgba(16,185,129,.5);
        }

        .ati-card .main {
            flex: 1;
            line-height: 1.55;
        }

        .ati-card input[type=checkbox] {
            width: 18px;
            height: 18px;
            margin-top: 4px;
            accent-color: #10b981;
        }

    .ati-route {
        font-size: 1.15em;
        font-weight: 700;
        color: #fff;
    }

    .ati-muted {
        color: #8fa9a6;
        font-size: .85em;
        font-weight: normal;
    }

    .ati-rate {
        font-weight: 700;
        color: #34d399;
    }

    .ati-actions button {
        margin: 8px 8px 0 0;
        padding: 5px 12px;
        border: 1px solid rgba(255,255,255,.2);
        background: transparent;
        color: #e6f1f0;
        border-radius: 6px;
        cursor: pointer;
    }

        .ati-actions button:hover:not(:disabled) {
            background: rgba(16,185,129,.25);
            border-color: #10b981;
        }

        .ati-actions button:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .ati-actions select {
        margin: 8px 8px 0 0;
        padding: 5px 8px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 6px;
        background: #0f2a30;
        color: #e6f1f0;
        color-scheme: dark;
        font: inherit;
    }

    .ati-actions .ati-muted {
        margin-right: 8px;
    }

    .ati-sec {
        max-width: 1000px;
        margin-bottom: 14px;
        padding: 14px 16px 16px;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 12px;
        background: rgba(255,255,255,.04);
    }

        .ati-sec h4 {
            margin: 0 0 10px;
            font-size: .95em;
            color: #34d399;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

    .ati-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 12px;
    }

    .atibox-title {
        color: inherit;
    }

    .atibox-all {
        color: inherit;
        opacity: .7;
    }

    .atibox-locked .atibox-title {
        color: inherit;
        opacity: .55;
    }

    .ati-field label {
        display: block;
        margin-bottom: 4px;
        font-size: .82em;
        color: #a9c3c0;
    }

    .ati-field input, .ati-field select, .ati-field textarea {
        width: 100%;
        padding: 8px 10px;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 8px;
        background: #0f2a30;
        color: #fff;
        color-scheme: dark;
        font: inherit;
    }

        .ati-field input::placeholder {
            color: #6f8a87;
        }

        .ati-field input:focus, .ati-field select:focus, .ati-field textarea:focus {
            outline: none;
            border-color: #10b981;
            box-shadow: 0 0 0 2px rgba(16,185,129,.25);
        }

    .ati-field.wide {
        grid-column: 1 / -1;
    }

    .ati-city {
        position: relative;
    }

    .ati-sug {
        position: absolute;
        z-index: 50;
        top: 100%;
        left: 0;
        right: 0;
        margin-top: 4px;
        background: #12343b;
        border: 1px solid #10b981;
        border-radius: 8px;
        max-height: 240px;
        overflow-y: auto;
        box-shadow: 0 8px 24px rgba(0,0,0,.5);
    }

        .ati-sug div {
            padding: 8px 10px;
            cursor: pointer;
            color: #e6f1f0;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

            .ati-sug div:last-child {
                border-bottom: none;
            }

            .ati-sug div:hover {
                background: #10b981;
                color: #fff;
            }

    .ati-btn {
        padding: 8px 18px;
        margin: 4px 8px 12px 0;
        border: 1px solid rgba(255,255,255,.2);
        background: rgba(255,255,255,.06);
        color: #e6f1f0;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }

        .ati-btn:hover:not(:disabled) {
            background: rgba(255,255,255,.14);
        }

        .ati-btn.primary {
            background: #10b981;
            border-color: #10b981;
            color: #fff;
        }

            .ati-btn.primary:hover:not(:disabled) {
                background: #0ea371;
            }

        .ati-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .ati-checks {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        margin-top: 4px;
    }

        .ati-checks label {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            color: #e6f1f0;
            font-size: .9em;
        }

        .ati-checks input {
            width: 16px;
            height: 16px;
            accent-color: #10b981;
        }

    .ati-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.3);
    }

    .ati-raw {
        max-width: 1000px;
        background: #071518;
        color: #cfe3e0;
        border: 1px solid rgba(255,255,255,.1);
        padding: 12px;
        border-radius: 8px;
        max-height: 420px;
        overflow: auto;
        white-space: pre-wrap;
        font-size: .8em;
    }
</style>

<h3>
    ATI.SU
    @if (account != null)
    {
        <span class="ati-muted">@account.FirmName (код @account.AtiId)</span>
    }
</h3>

@if (Svc.IsExpired)
{
    <div class="ati-msg err">Срок действия токена ATI истёк @Svc.ExpiresAt.ToString("dd.MM.yyyy"). Обновите токен в appsettings.json.</div>
}
else if (!Svc.IsConfigured)
{
    <div class="ati-msg err">ATI не настроен: проверьте раздел Ati в appsettings.json.</div>
}
else
{
    @if (Svc.IsDryRun)
    {
        <div class="ati-msg">Режим DryRun: в ATI ничего не отправляется.</div>
    }

    <div class="ati-tabs">
        <button class="@(tab == "list" ? "on" : "")" @onclick='() => tab = "list"'>Мои грузы (@loads.Count)</button>
        <button class="@(tab == "form" ? "on" : "")" @onclick='() => tab = "form"'>@(editId != null ? "Редактирование" : "Выставить груз")</button>
        <button class="@(tab == "other" ? "on" : "")" @onclick='() => tab = "other"'>Площадки и предложения</button>
        <button class="@(tab == "archive" ? "on" : "")" @onclick='() => tab = "archive"'>Архив@(archiveLoaded ? " (" + archived.Count + ")" : "")</button>
        <button type="button" class="@(tab == "orders" ? "on" : "")"
                @onclick='() => { tab = "orders"; }'>
            Заказы
        </button>
    </div>

    @if (msg.Length > 0)
    {
        <div class="ati-msg @(msgError ? "err" : "")">
            @msg
            @if (docUrl.Length > 0)
            {
                <a href="@docUrl" target="_blank">Открыть документ</a>
            }
        </div>
    }

    @if (tab == "list")
    {
        <div>
            <button class="ati-btn" disabled="@busy" @onclick="() => Run(LoadCargos)">Обновить список</button>
            <button class="ati-btn primary" disabled="@(busy || selected.Count == 0)" @onclick="() => Run(RefreshSelected)">
                Поднять выбранные (@selected.Count)
            </button>
        </div>

        <div class="ati-actions">
            <label for="ati-contact-filter">Контакт в объявлении</label>
            <select id="ati-contact-filter" @bind="loadContactFilter">
                <option value="">Все контакты</option>
                @foreach (var contactId in loads.Select(l => l.ContactId)
                                               .Distinct()
                                               .OrderBy(id => LoadContactName(id)))
                {
                    <option value="@contactId">@LoadContactName(contactId)</option>
                }
            </select>
        </div>

        @if (loads.Count > 0 && !FilteredLoads.Any())
        {
            <p class="ati-muted">По выбранному контакту грузов нет.</p>
        }

        @if (loads.Count == 0)
        {
            <p class="ati-muted">Опубликованных грузов нет.</p>
        }

        @foreach (var l in FilteredLoads)
        {
            <div class="ati-card">
                <div>
                    <input type="checkbox"
                           checked="@selected.Contains(l.Id)"
                           disabled="@(!l.CanBeRenewed)"
                           title="@(l.CanBeRenewed ? "Поднять в топ" : l.RenewRestriction)"
                           @onchange="e => Toggle(l.Id, e.Value is true)" />
                </div>
                <div class="main">
                    <div class="ati-route">
                        @Svc.CityName(l.LoadingCityId) → @Svc.CityName(l.UnloadingCityId)
                        @if (l.Distance > 0)
                        {
                            <span class="ati-muted">@l.Distance км</span>
                        }
                    </div>
                    <div>
                        @l.CargoName
                        @if (l.Weight > 0)
                        {
                            <span> · @l.Weight.ToString("0.###") т</span>
                        }
                        @if (l.Volume > 0)
                        {
                            <span> · @l.Volume.ToString("0.###") м³</span>
                        }
                        @if (Svc.BodyNames(l.CarTypeMask).Length > 0)
                        {
                            <span> · @Svc.BodyNames(l.CarTypeMask)</span>
                        }
                    </div>
                    <div><span class="ati-rate">@RateText(l)</span> · @DateText(l)</div>
                    <div class="ati-muted">
                        Контакт в объявлении: @LoadContactName(l.ContactId)
                    </div>
                    <div class="ati-muted">
                        № @l.Number
                        @if (l.AddedAt != null)
                        {
                            <span> · добавлен @l.AddedAt.Value.ToString("dd.MM HH:mm")</span>
                        }
                        @if (l.OfferCount > 0)
                        {
                            <span> · предложений: @l.OfferCount</span>
                        }
                    </div>
                    @if (l.Note.Length > 0)
                    {
                        <div class="ati-muted">@l.Note</div>
                    }
                    @if (l.BoardIds.Count > 0)
                    {
                        <div class="ati-muted">Площадки: @Svc.BoardNames(l.BoardIds)</div>
                    }
                    @if (!l.CanBeRenewed && l.RenewRestriction.Length > 0)
                    {
                        <div class="ati-muted">@l.RenewRestriction</div>
                    }
                    @if (refreshErrors.TryGetValue(l.Id, out var rerr))
                    {
                        <div class="ati-muted" style="color:#fca5a5">Не поднят: @rerr</div>
                    }
                    <div class="ati-actions">
                        @if (confirmArchiveId == l.Id)
                        {
                            <span class="ati-muted">Снять груз с публикации?</span>
                            <button disabled="@busy" @onclick="() => Run(() => ArchiveLoad(l))">Да, в архив</button>
                            <button @onclick="() => confirmArchiveId = null">Отмена</button>
                        }
                        else
                        {
                            <button type="button"
                                    disabled="@(busy || !l.CanBeRenewed)"
                                    title="@(!l.CanBeRenewed ? l.RenewRestriction : "Поднять груз в ТОП")"
                                    @onclick="() => Run(() => RefreshOne(l))">
                                Поднять в ТОП
                            </button>
                            <button disabled="@(busy || !l.CanBeEdited)" @onclick="() => Run(() => OpenDraft(l, true))">Редактировать</button>
                            <button disabled="@busy" @onclick="() => Run(() => OpenDraft(l, false))">Копировать</button>
                            <button disabled="@busy" @onclick="() => Run(() => FindTrucks(l))">
                                Найти машину
                            </button>
                            <button disabled="@busy" @onclick="() => confirmArchiveId = l.Id">В архив</button>
                            <select @bind="docType">
                                @foreach (var t in DocTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                            <button disabled="@busy" @onclick="() => Run(() => CreateAtiDoc(l))">Создать документ</button>
                        }

                        @if (truckCargoId == l.Id)
                        {
                            <div class="ati-sec" style="margin-top:12px">
                                <h4>Поиск транспорта</h4>

                                <label>
                                    <input type="checkbox" @bind="truckDemo" disabled="@(busy || Svc.IsDryRun)" />
                                    Демо ATI
                                </label>
                                <button class="ati-btn" disabled="@busy" @onclick="() => Run(() => FindTrucks(l))">
                                    Повторить поиск
                                </button>
                                <button class="ati-btn" disabled="@busy" @onclick="() => truckCargoId = null">
                                    Закрыть
                                </button>

                                @if (truckSearchCompleted)
                                {
                                    @if (truckLastSearchWasDemo)
                                    {
                                        <p class="ati-muted">Демо-выдача: не используйте её для заказа машины.</p>
                                    }

                                    <p class="ati-muted">
                                        Найдено: @truckTotal · скрыто ATI: @truckHidden · показано: @truckItems.Count
                                    </p>

                                    @if (truckItems.Count == 0)
                                    {
                                        <p class="ati-muted">Нет доступных для показа машин по этому запросу.</p>
                                    }

                                    @foreach (var t in truckItems)
                                    {
                                        <div class="ati-card">
                                            <div class="main">
                                                <div class="ati-route">
                                                    @(string.IsNullOrWhiteSpace(t.FirmName) ? "Перевозчик" : t.FirmName)
                                                    @if (t.AtiId.Length > 0)
                                                    {
                                                        <span class="ati-muted"> · АТИ @t.AtiId</span>
                                                    }
                                                </div>
                                                <div>
                                                    Откуда: @Svc.CityName(t.LoadingCityId)
                                                    @if (t.Weight > 0)
                                                    {
                                                        <span> · до @t.Weight.ToString("0.###") т</span>
                                                    }
                                                    @if (t.Volume > 0)
                                                    {
                                                        <span> · @t.Volume.ToString("0.###") м³</span>
                                                    }
                                                    @if (Svc.BodyNames(t.CarType).Length > 0)
                                                    {
                                                        <span> · @Svc.BodyNames(t.CarType)</span>
                                                    }
                                                </div>
                                                @if (t.FirstDate is DateTime first)
                                                {
                                                    <div class="ati-muted">
                                                        Доступна с @first.ToString("dd.MM.yyyy")
                                                        @if (t.LastDate is DateTime last && last != first)
                                                        {
                                                            <span> до @last.ToString("dd.MM.yyyy")</span>
                                                        }
                                                    </div>
                                                }
                                                @if (t.Note.Length > 0)
                                                {
                                                    <div>@t.Note</div>
                                                }
                                                @if (t.Contacts.Count == 0)
                                                {
                                                    <div class="ati-muted">Контакты по объявлению не получены.</div>
                                                }
                                                @foreach (var contact in t.Contacts)
                                                {
                                                    <div>@contact</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    }

    @if (tab == "form")
    {
        @if (editId != null)
        {
            <div class="ati-msg">
                Редактируется груз № @editNumber. ATI сохраняет груз целиком из этой формы:
                то, чего в форме нет (промежуточные точки, время и даты разгрузки, доп. требования к машине), будет сброшено.
            </div>
        }

        <div class="ati-sec">
            <h4>Загрузка</h4>
            <div class="ati-grid">
                <div class="ati-field ati-city">
                    <label for="ati-loading-city">Город загрузки</label>
                    <input id="ati-loading-city"
                           value="@loadQuery"
                           placeholder="Начните вводить город"
                           autocomplete="off"
                           @oninput="e => SearchCity(true, e.Value?.ToString())" />

                    @if (loadSug.Count > 0)
                    {
                        <div class="ati-sug">
                            @foreach (var s in loadSug)
                            {
                                <div @onclick="() => PickCity(true, s)">@s.Address</div>
                            }
                        </div>
                    }
                </div>

                <div class="ati-field">
                    <label for="ati-loading-address">Адрес загрузки</label>
                    <input id="ati-loading-address" @bind="draft.LoadingAddress" />
                </div>

                <div class="ati-field">
                    <label for="ati-loading-date">Дата загрузки</label>
                    <input id="ati-loading-date" type="date" @bind="draft.LoadingDate" />
                </div>
            </div>
        </div>

        <div class="ati-sec">
            <h4>Разгрузка</h4>
            <div class="ati-grid">
                <div class="ati-field ati-city">
                    <label for="ati-unloading-city">Город выгрузки</label>
                    <input id="ati-unloading-city"
                           value="@unloadQuery"
                           placeholder="Начните вводить город"
                           autocomplete="off"
                           @oninput="e => SearchCity(false, e.Value?.ToString())" />

                    @if (unloadSug.Count > 0)
                    {
                        <div class="ati-sug">
                            @foreach (var s in unloadSug)
                            {
                                <div @onclick="() => PickCity(false, s)">@s.Address</div>
                            }
                        </div>
                    }
                </div>

                <div class="ati-field">
                    <label for="ati-unloading-address">Адрес выгрузки</label>
                    <input id="ati-unloading-address" @bind="draft.UnloadingAddress" />
                </div>
            </div>
        </div>

        <div class="ati-sec">
            <h4>Груз и машина</h4>

            <div class="ati-grid">
                <div class="ati-field">
                    <label for="ati-cargo-name">Груз</label>
                    <input id="ati-cargo-name" type="text" list="ati-cargo-names"
                           placeholder="Начни вводить наименование"
                           @bind="draft.CargoName" />
                    <datalist id="ati-cargo-names">
                        @foreach (var cargoName in cargoNames)
                        {
                            <option value="@cargoName"></option>
                        }
                    </datalist>
                </div>

                <div class="ati-field">
                    <label>Вес, т</label>
                    <input type="number" step="any" @bind="draft.Weight" />
                </div>

                <div class="ati-field">
                    <label>Объём, м³</label>
                    <input type="number" step="any" @bind="draft.Volume" />
                </div>

                <div class="ati-field">
                    <label>Машин</label>
                    <input type="number" min="1" @bind="draft.TrucksCount" />
                </div>

                <div class="ati-field">
                    <label for="ati-load-type">Тип перевозки</label>
                    <select id="ati-load-type" @bind="draft.LoadType">
                        <option value="ftl">Отдельной машиной</option>
                        <option value="ltl">Догрузом</option>
                        <option value="dont-care">Не важно</option>
                    </select>
                </div>

                <div class="ati-field">
                    <label>Грузоподъёмность, т</label>
                    <input type="number" step="any" @bind="draft.RequiredCapacity" />
                </div>
            </div>

            <style>
                    .atw-row {
                        display: grid;
                        grid-template-columns: repeat(3, minmax(0, 1fr));
                        gap: 10px;
                        max-width: 100%;
                        margin: 12px 0 0;
                    }

                    .atw {
                        display: flex;
                        flex-direction: column;
                        min-width: 0;
                        border: 1px solid #2f5d63;
                        border-radius: 12px;
                        background: #0f2a30;
                        overflow: hidden;
                    }

                        .atw:focus-within {
                            border-color: #2dd4a3;
                        }

                    .atw-head {
                        display: flex;
                        align-items: center;
                        flex-wrap: wrap;
                        gap: 4px 8px;
                        padding: 8px 10px;
                        border-bottom: 1px solid #25494f;
                        background: #143a41;
                    }

                        .atw-head strong {
                            font-size: 12px;
                            font-weight: 600;
                            color: #e6f4f1;
                        }

                    .atw-count {
                        padding: 0 7px;
                        border-radius: 999px;
                        background: #2dd4a3;
                        color: #06241d;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    .atw-head .atw-all {
                        display: inline-flex;
                        align-items: center;
                        gap: 4px;
                        margin: 0 0 0 auto;
                        font-size: 10px;
                        font-weight: 400;
                        color: #9fc4c0;
                        white-space: nowrap;
                        cursor: pointer;
                    }

                    .atw-head input[type="checkbox"] {
                        width: 13px;
                        height: 13px;
                        margin: 0;
                        accent-color: #2dd4a3;
                    }

                    .atw-search-wrap {
                        position: relative;
                        padding: 8px 8px 0;
                    }

                    .atw-search {
                        box-sizing: border-box;
                        width: 100%;
                        height: 28px;
                        margin: 0;
                        padding: 0 26px 0 9px;
                        border: 1px solid #2f5d63;
                        border-radius: 8px;
                        background: #0a1f24;
                        color: #e6f4f1;
                        font-size: 12px;
                        outline: none;
                    }

                        .atw-search:focus {
                            border-color: #2dd4a3;
                        }

                    .atw-search-icon {
                        position: absolute;
                        top: 14px;
                        right: 16px;
                        color: #6f9a98;
                        font-size: 13px;
                        pointer-events: none;
                    }

                    .atw-list {
                        height: 180px;
                        overflow-y: auto;
                        padding: 6px;
                    }

                        .atw-list::-webkit-scrollbar {
                            width: 6px;
                        }

                        .atw-list::-webkit-scrollbar-thumb {
                            background: #2f5d63;
                            border-radius: 999px;
                        }

                    .atw-item {
                        display: flex;
                        align-items: center;
                        gap: 7px;
                        width: auto;
                        min-height: 26px;
                        margin: 0;
                        padding: 0 6px;
                        border-radius: 6px;
                        color: #d3e8e5;
                        font-size: 12px;
                        font-weight: 400;
                        cursor: pointer;
                        user-select: none;
                    }

                        .atw-item:hover {
                            background: #17424a;
                        }

                        .atw-item input[type="checkbox"] {
                            flex: 0 0 auto;
                            width: 14px;
                            height: 14px;
                            margin: 0;
                            accent-color: #2dd4a3;
                        }

                    .atw-empty {
                        margin: 8px 6px;
                        color: #6f9a98;
                        font-size: 12px;
                    }

                    .atw-locked {
                        opacity: .5;
                        pointer-events: none;
                    }

                    .atw-tags {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 5px;
                        padding: 8px 0 0;
                    }

                    .atw-tag {
                        display: inline-flex;
                        align-items: center;
                        gap: 4px;
                        padding: 2px 9px;
                        border-radius: 999px;
                        background: #17424a;
                        color: #bff3e4;
                        font-size: 11px;
                    }

                        .atw-tag button {
                            padding: 0;
                            border: 0;
                            background: transparent;
                            color: #2dd4a3;
                            font-size: 13px;
                            line-height: 1;
                            cursor: pointer;
                        }

                    @@media (max-width: 900px) {
                        .atw-row {
                            grid-template-columns: 1fr;
                        }
                    }
            </style>

            <div class="atw-row">

                <div class="atw">
                    <div class="atw-head">
                        <strong>Кузов</strong>
                        <span class="atw-count">@draft.BodyTypeIds.Count</span>
                    </div>

                    <div class="atw-search-wrap">
                        <input type="text" class="atw-search" placeholder="Поиск"
                               @bind="bodyBoxSearch" @bind:event="oninput" />
                        <span class="atw-search-icon">⌕</span>
                    </div>

                    <div class="atw-list">
                        @foreach (var atwBody in atwBodies)
                        {
                            var atwBodyId = Svc.BodyValue(atwBody);

                            <label class="atw-item" @key="atwBodyId">
                                <input type="checkbox"
                                       checked="@draft.BodyTypeIds.Contains(atwBodyId)"
                                       @onchange="e => ToggleBodyType(atwBodyId, e.Value is true)" />
                                <span>@atwBody.Name</span>
                            </label>
                        }

                        @if (atwBodies.Count == 0)
                        {
                            <div class="atw-empty">Кузова не найдены</div>
                        }
                    </div>
                </div>

                <div class="atw @(atwLocked ? "atw-locked" : "")">
                    <div class="atw-head">
                        <strong>Загрузка</strong>
                        <span class="atw-count">@draft.BodyLoadingTypeIds.Count</span>

                        <label class="atw-all">
                            <input type="checkbox"
                                   checked="@draft.IsAllBodyLoadingRequired"
                                   disabled="@(draft.BodyLoadingTypeIds.Count == 0)"
                                   @onchange="e => draft.IsAllBodyLoadingRequired = e.Value is true" />
                            <span>все выбранные</span>
                        </label>
                    </div>

                    <div class="atw-search-wrap">
                        <input type="text" class="atw-search" placeholder="Поиск"
                               @bind="loadBoxSearch" @bind:event="oninput" />
                        <span class="atw-search-icon">⌕</span>
                    </div>

                    <div class="atw-list">
                        @foreach (var atwOpt in atwLoad)
                        {
                            <label class="atw-item" @key="atwOpt.Id">
                                <input type="checkbox"
                                       checked="@draft.BodyLoadingTypeIds.Contains(atwOpt.Id)"
                                       @onchange="e => SetHandlingMethod(draft.BodyLoadingTypeIds, atwOpt.Id, e.Value is true)" />
                                <span>@atwOpt.Name</span>
                            </label>
                        }

                        @if (atwLoad.Count == 0)
                        {
                            <div class="atw-empty">@(handlingOptions.Count == 0 ? "Справочник не загружен" : "Ничего не найдено")</div>
                        }
                    </div>
                </div>

                <div class="atw @(atwLocked ? "atw-locked" : "")">
                    <div class="atw-head">
                        <strong>Выгрузка</strong>
                        <span class="atw-count">@draft.BodyUnloadingTypeIds.Count</span>

                        <label class="atw-all">
                            <input type="checkbox"
                                   checked="@draft.IsAllBodyUnloadingRequired"
                                   disabled="@(draft.BodyUnloadingTypeIds.Count == 0)"
                                   @onchange="e => draft.IsAllBodyUnloadingRequired = e.Value is true" />
                            <span>все выбранные</span>
                        </label>
                    </div>

                    <div class="atw-search-wrap">
                        <input type="text" class="atw-search" placeholder="Поиск"
                               @bind="unloadBoxSearch" @bind:event="oninput" />
                        <span class="atw-search-icon">⌕</span>
                    </div>

                    <div class="atw-list">
                        @foreach (var atwOpt in atwUnload)
                        {
                            <label class="atw-item" @key="atwOpt.Id">
                                <input type="checkbox"
                                       checked="@draft.BodyUnloadingTypeIds.Contains(atwOpt.Id)"
                                       @onchange="e => SetHandlingMethod(draft.BodyUnloadingTypeIds, atwOpt.Id, e.Value is true)" />
                                <span>@atwOpt.Name</span>
                            </label>
                        }

                        @if (atwUnload.Count == 0)
                        {
                            <div class="atw-empty">@(handlingOptions.Count == 0 ? "Справочник не загружен" : "Ничего не найдено")</div>
                        }
                    </div>
                </div>

            </div>

            @if (draft.BodyTypeIds.Count > 0)
            {
                <div class="atw-tags">
                    @foreach (var atwBody in atwBodies.Where(b => draft.BodyTypeIds.Contains(Svc.BodyValue(b))))
                    {
                        var atwTagId = Svc.BodyValue(atwBody);

                        <span class="atw-tag">
                            @atwBody.Name
                            <button type="button" title="Убрать"
                                    @onclick="() => ToggleBodyType(atwTagId, false)">
                                ×
                            </button>
                        </span>
                    }
                </div>
            }
        </div>


        <div class="ati-sec">
            <h4>Оплата</h4>
            <div class="ati-grid">
                <div class="ati-field">
                    <label>Тип</label>
                    <select @bind="draft.PaymentType">
                        <option value="without-bargaining">Без торга</option>
                        <option value="with-bargaining">Возможен торг</option>
                        <option value="rate-request">Запрос ставки</option>
                    </select>
                </div>
                <div class="ati-field"><label>Ставка без НДС</label><input type="number" step="any" @bind="draft.RateWithoutVat" /></div>
                <div class="ati-field"><label>Ставка с НДС</label><input type="number" step="any" @bind="draft.RateWithVat" /></div>
                <div class="ati-field"><label>НДС, %</label><input type="number" placeholder="не указан" @bind="draft.VatPercent" /></div>
                <div class="ati-field"><label>Наличными</label><input type="number" step="any" @bind="draft.Cash" /></div>
            </div>
        </div>

        <div class="ati-sec">
            <h4>Контакт и публикация</h4>
            <div class="ati-grid">
                <div class="ati-field">
                    <label>Контакт</label>
                    <select @bind="draft.ContactId">
                        @if (account != null)
                        {
                            @foreach (var c in account.Contacts)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="ati-field">
                    <label>Публикация</label>
                    <select @bind="draft.PublicationMode">
                        <option value="now">Сразу</option>
                        <option value="15m">Через 15 минут</option>
                        <option value="30m">Через 30 минут</option>
                        <option value="1h">Через час</option>
                        <option value="3h">Через 3 часа</option>
                        <option value="6h">Через 6 часов</option>
                    </select>
                </div>
                <div class="ati-field wide">
                    <label>Площадки</label>
                    <div class="ati-checks">
                        <label>
                            <input type="checkbox" checked="@draft.BoardIds.Contains(AtiBoards.CommonId)"
                                   @onchange="e => ToggleDraftBoard(AtiBoards.CommonId, e.Value is true)" />
                            @AtiBoards.CommonName
                        </label>
                        @foreach (var b in boards.Where(x => x.CanAdd))
                        {
                            <label>
                                <input type="checkbox" checked="@draft.BoardIds.Contains(b.Id)"
                                       @onchange="e => ToggleDraftBoard(b.Id, e.Value is true)" />
                                @if (b.Color.Length > 0)
                                {
                                    <span class="ati-dot" style="background:@b.Color"></span>
                                }
                                @b.Name
                                @if (b.IsOwner)
                                {
                                    <span class="ati-muted">(моя)</span>
                                }
                            </label>
                        }
                    </div>
                    @if (boardsError.Length > 0)
                    {
                        <div class="ati-muted" style="color:#fca5a5">Список площадок не загружен: @boardsError</div>
                    }
                </div>
                <div class="ati-field wide"><label>Примечание</label><textarea rows="2" @bind="draft.Note"></textarea></div>
            </div>
        </div>

        <div>
            <button class="ati-btn primary" disabled="@busy" @onclick="() => Run(Submit)">@(editId != null ? "Сохранить изменения" : "Опубликовать")</button>
            <button class="ati-btn" disabled="@busy" @onclick="Preview">Проверить и показать JSON</button>
            <button class="ati-btn" disabled="@busy" @onclick="ResetForm">@(editId != null ? "Отменить редактирование" : "Очистить")</button>
        </div>
    }

    @if (tab == "other")
    {
        <div>
            <button class="ati-btn primary" disabled="@busy" @onclick="() => Run(LoadCounterOffers)">Встречные предложения</button>
            <button class="ati-btn" disabled="@busy" @onclick="() => Run(LoadCounterOffersRaw)">Предложения (JSON)</button>
        </div>

        <div class="ati-sec">
            <h4>Входящие приглашения</h4>

            <button type="button" class="ati-btn" disabled="@busy"
                    @onclick="() => Run(LoadIncomingInvites)">
                Обновить приглашения
            </button>

            @if (incomingInvitesEmpty)
            {
                <p class="ati-muted">Нет входящих приглашений.</p>
            }
            else if (incomingInvitesJson.Length > 0)
            {
                <details>
                    <summary>Ответ ATI.SU (JSON)</summary>
                    <pre class="ati-raw">@incomingInvitesJson</pre>
                </details>
            }
        </div>

        @if (offersLoaded && offers.Count == 0)
        {
            <p class="ati-muted">Встречных предложений нет.</p>
        }

        @foreach (var o in offers)
        {
            var load = loads.FirstOrDefault(x => x.Id == o.CargoId);

            <div class="ati-card">
                <div class="main">
                    <div class="ati-route">
                        @o.FirmName
                        @if (o.Score > 0)
                        {
                            <span class="ati-muted">★ @o.Score.ToString("0.#")</span>
                        }
                        @if (o.IsOutdated)
                        {
                            <span class="ati-muted">· устарело</span>
                        }
                    </div>
                    <div><span class="ati-rate">@OfferRateText(o)</span></div>
                    <div class="ati-muted">
                        Груз № @o.CargoNumber
                        @if (load != null)
                        {
                            <span> · @Svc.CityName(load.LoadingCityId) → @Svc.CityName(load.UnloadingCityId)</span>
                        }
                        @if (o.LoadingDate != null)
                        {
                            <span> · заберут @o.LoadingDate.Value.ToString("dd.MM")</span>
                        }
                        @if (o.AddedAt != null)
                        {
                            <span> · получено @o.AddedAt.Value.ToString("dd.MM HH:mm")</span>
                        }
                    </div>
                    @if (o.ContactName.Length > 0 || o.Phone.Length > 0)
                    {
                        <div>
                            @o.ContactName
                            @if (o.Phone.Length > 0)
                            {
                                <a href="tel:@o.Phone" style="color:#34d399; margin-left:8px">@o.Phone</a>
                            }
                        </div>
                    }
                    @if (o.Note.Length > 0)
                    {
                        <div class="ati-muted">@o.Note</div>
                    }
                    <div class="ati-actions">
                        @if (confirmOfferId == o.Id)
                        {
                            <button disabled="@busy" @onclick="() => Run(() => DeleteOffer(o))">Да, удалить</button>
                            <button @onclick="() => confirmOfferId = null">Отмена</button>
                        }
                        else
                        {
                            <button disabled="@busy" @onclick="() => confirmOfferId = o.Id">Удалить</button>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="ati-sec" style="margin-top:18px">
            <h4>Поиск по площадкам</h4>
            @if (boards.Any(x => x.CanView))
            {
                <div class="ati-field">
                    <label>Площадки (ничего не отмечено — все закрытые площадки)</label>
                    <div class="ati-checks">
                        @foreach (var b in boards.Where(x => x.CanView))
                        {
                            <label>
                                <input type="checkbox" checked="@boardSearchSel.Contains(b.Id)"
                                       @onchange="e => ToggleSearchBoard(b.Id, e.Value is true)" />
                                @if (b.Color.Length > 0)
                                {
                                    <span class="ati-dot" style="background:@b.Color"></span>
                                }
                                @b.Name
                                @if (b.ContentCount > 0)
                                {
                                    <span class="ati-muted">(@b.ContentCount)</span>
                                }
                            </label>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="ati-field">
                    <label>ID площадок через запятую (пусто — все закрытые площадки)</label>
                    <input @bind="boardIdsText" />
                </div>
                @if (boardsError.Length > 0)
                {
                    <div class="ati-muted" style="color:#fca5a5">Список площадок не загружен: @boardsError</div>
                }
            }
            <button class="ati-btn primary" style="margin-top:10px" disabled="@busy" @onclick="() => Run(SearchBoards)">Искать</button>
            <button class="ati-btn" style="margin-top:10px" disabled="@busy" @onclick="() => Run(SearchBoardsRaw)">Результат (JSON)</button>
        </div>

        @if (boardSearched)
        {
            <p class="ati-muted">Найдено: @boardTotal, показано: @boardCargos.Count</p>
        }

        @foreach (var bc in boardCargos)
        {
            <div class="ati-card">
                <div class="main">
                    <div class="ati-route">
                        @Svc.CityName(bc.LoadingCityId) → @Svc.CityName(bc.UnloadingCityId)
                        @if (bc.Distance > 0)
                        {
                            <span class="ati-muted">@bc.Distance км</span>
                        }
                    </div>
                    <div>
                        @bc.CargoName
                        @if (bc.Weight > 0)
                        {
                            <span> · @bc.Weight.ToString("0.###") т</span>
                        }
                        @if (bc.Volume > 0)
                        {
                            <span> · @bc.Volume.ToString("0.###") м³</span>
                        }
                        @if (Svc.BodyNamesByTypeIds(bc.BodyTypeIds).Length > 0)
                        {
                            <span> · @Svc.BodyNamesByTypeIds(bc.BodyTypeIds)</span>
                        }
                    </div>
                    <div><span class="ati-rate">@BoardRateText(bc)</span> · @BoardDateText(bc)</div>
                    @if (bc.LoadingAddress.Length > 0 || bc.UnloadingAddress.Length > 0)
                    {
                        <div class="ati-muted">@bc.LoadingAddress → @bc.UnloadingAddress</div>
                    }
                    <div class="ati-muted">
                        № @bc.Number
                        @if (bc.AtiId > 0)
                        {
                            <span> · код АТИ @bc.AtiId</span>
                        }
                        @if (bc.AddedAt != null)
                        {
                            <span> · добавлен @bc.AddedAt.Value.ToString("dd.MM HH:mm")</span>
                        }
                        @if (bc.OfferCount > 0)
                        {
                            <span> · предложений: @bc.OfferCount</span>
                        }
                    </div>
                    @if (bc.Note.Length > 0)
                    {
                        <div class="ati-muted">@bc.Note</div>
                    }

                    @if (offerCargoId == bc.Id)
                    {
                        <fieldset class="ati-grid" style="margin:10px 0 0; padding:0; border:0"
          disabled="@(busy || confirmSendOfferId == bc.Id)">
                            <div class="ati-field"><label>Ставка с НДС</label><input type="number" step="any" @bind="offerDraft.NdsPrice" /></div>
                            <div class="ati-field"><label>НДС, %</label><input type="number" min="1" max="99" @bind="offerDraft.NdsPercent" /></div>
                            <div class="ati-field"><label>Ставка без НДС</label><input type="number" step="any" @bind="offerDraft.NotNdsPrice" /></div>
                            <div class="ati-field"><label>Наличными</label><input type="number" step="any" @bind="offerDraft.Price" /></div>
                            <div class="ati-field"><label>Дата загрузки</label><input type="date" @bind="offerDraft.LoadingDate" /></div>
                            <div class="ati-field"><label>Предоплата, %</label><input type="number" min="0" max="100" @bind="offerDraft.PrepayPercent" /></div>
                            <div class="ati-field"><label>Оплата через, банк. дней</label><input type="number" min="0" max="99" @bind="offerDraft.PayAfterBankDays" /></div>
                            <div class="ati-field wide"><label>Примечание</label><input maxlength="512" @bind="offerDraft.Note" /></div>
                        </fieldset>

                        <div class="ati-actions">
                            @if (confirmSendOfferId == bc.Id)
                            {
                                <div class="ati-msg">
                                    <strong>Проверьте предложение по грузу № @bc.Number</strong>
                                    <div>Ставка: @OfferDraftRateText()</div>

                                    @if (offerDraft.LoadingDate is DateTime loadingDate)
                                    {
                                        <div>Дата загрузки: @loadingDate.ToString("dd.MM.yyyy")</div>
                                    }
                                    @if (offerDraft.PrepayPercent > 0)
                                    {
                                        <div>Предоплата: @(offerDraft.PrepayPercent)%</div>
                                    }
                                    @if (offerDraft.PayAfterBankDays > 0)
                                    {
                                        <div>Оплата через @offerDraft.PayAfterBankDays банк. дн.</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(offerDraft.Note))
                                    {
                                        <div>Примечание: @offerDraft.Note</div>
                                    }

                                    @if (activeOfferCargoIds.Contains(bc.Id) &&
                                         (!myOffers.TryGetValue(bc.Id, out var savedOffer) ||
                                          string.IsNullOrEmpty(savedOffer.Id)))
                                    {
                                        <div>
                                            <strong>Внимание:</strong> при замене ATI сначала отзовёт старое
                                            предложение. Если отправка нового не удастся, старое уже будет отозвано.
                                        </div>
                                    }

                                    @if (Svc.IsDryRun)
                                    {
                                        <div>DryRun: запрос будет показан, но не отправлен.</div>
                                    }
                                </div>

                                <button type="button" disabled="@busy"
                                        @onclick="() => ConfirmSendOffer(bc)">
                                    Подтвердить
                                </button>
                                <button type="button" disabled="@busy"
                                        @onclick="() => { confirmSendOfferId = null; }">
                                    Назад к форме
                                </button>
                            }
                            else
                            {
                                <button type="button" disabled="@busy"
                                        @onclick="() => { confirmSendOfferId = bc.Id; }">
                                    @(myOffers.ContainsKey(bc.Id) || activeOfferCargoIds.Contains(bc.Id)
                                        ? "Проверить изменения"
                                        : "Проверить предложение")
                                </button>
                                <button type="button" disabled="@busy"
                                        @onclick="() => { offerCargoId = null; }">
                                    Отмена
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ati-actions">
                            @if (myOffers.TryGetValue(bc.Id, out var mine))
                            {
                                <span class="ati-muted">Ваше предложение: @OfferRateText(mine)</span>
                                <button disabled="@busy" @onclick="() => OpenOffer(bc, mine)">Изменить</button>
                                <button disabled="@busy" @onclick="() => Run(() => WithdrawOffer(bc))">Отозвать</button>
                            }
                            else if (activeOfferCargoIds.Contains(bc.Id))
                            {
                                <span class="ati-muted">У вас есть активное предложение</span>
                                <button disabled="@busy" @onclick="() => OpenOffer(bc)">Изменить</button>
                                <button disabled="@busy" @onclick="() => Run(() => WithdrawOffer(bc))">Отозвать</button>
                            }
                            else
                            {
                                <button disabled="@busy" @onclick="() => OpenOffer(bc)">Сделать предложение</button>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (boardSearched && boardSkip < boardTotal && boardSkip + 100 <= 10000)
        {
            <button class="ati-btn" disabled="@busy" @onclick="() => Run(MoreBoards)">Показать ещё</button>
        }
    }

@if (tab == "orders")
{
    <div class="ati-sec">
        <h4>Заказы</h4>

        <button type="button" class="ati-btn" disabled="@busy"
                @onclick="() => Run(LoadOrders)">
            Загрузить заказы
        </button>

        @if (orderRows.Count > 0)
        {
            <p>Получено заказов: @orderRows.Count</p>

            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">№ заказа</th>
                            <th scope="col">№ груза</th>
                            <th scope="col">Загрузка → разгрузка</th>
                            <th scope="col">Статус ATI</th>
                            <th scope="col">Активные ставки</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orderRows)
                        {
                            <tr>
                                    <td>
                                        <button type="button" class="ati-btn"
                                                @onclick="() => { selectedOrder = order; }">
                                            @order.OrderNumber
                                        </button>
                                    </td>
                                <td>@order.LoadNumber</td>
                                <td>@order.Route</td>
                                <td>@order.Status</td>
