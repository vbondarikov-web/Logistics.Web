    private async Task SendOffer(AtiBoardCargo c)
    {
        (AtiOffer? Offer, string Raw) result;
        string done;

        if (myOffers.TryGetValue(c.Id, out var existing) && existing.Id.Length > 0)
        {
            // ID предложения известен — меняем его напрямую
            result = await Svc.UpdateCounterOfferAsync(c.Id, existing.Id, offerDraft);
            done = "Предложение изменено.";
        }
        else if (activeOfferCargoIds.Contains(c.Id))
        {
            // предложение есть, но ID неизвестен (после перезагрузки) — отзываем и отправляем заново
            result = await Svc.ReplaceCounterOfferAsync(c.Id, offerDraft);
            done = "Предложение заменено.";
        }
        else
        {
            result = await Svc.CreateCounterOfferAsync(c.Id, offerDraft);
            done = "Предложение по грузу № " + c.Number + " отправлено.";
        }

        if (Svc.IsDryRun)
        {
            raw = result.Raw;
            msg = "DryRun: предложение не отправлено, тело показано внизу страницы.";
            return;
        }

        if (result.Offer != null) myOffers[c.Id] = result.Offer;
        activeOfferCargoIds.Add(c.Id);
        offerCargoId = null;
        msg = done;
    }

    private async Task WithdrawOffer(AtiBoardCargo c)
    {
        if (Svc.IsDryRun)
        {
            msg = "DryRun: запрос на отзыв не отправлен.";
            return;
        }

        await Svc.DeleteMyCounterOffersAsync(c.Id);
        myOffers.Remove(c.Id);
        activeOfferCargoIds.Remove(c.Id);
        if (offerCargoId == c.Id) offerCargoId = null;
        msg = "Предложение по грузу № " + c.Number + " отозвано.";
    }

    private static string BoardRateText(AtiBoardCargo c)
    {
        if (c.PaymentType == "auction") return "Торги";
        if (c.PaymentType == "rate-request") return "Запрос ставки";

        var parts = new List<string>();
        if (c.RateWithVat > 0) parts.Add(c.RateWithVat.ToString("N0") + " с НДС");
        if (c.RateWithoutVat > 0) parts.Add(c.RateWithoutVat.ToString("N0") + " без НДС");
        if (c.Cash > 0) parts.Add(c.Cash.ToString("N0") + " нал");

        var torg = c.PaymentType == "with-bargaining" ? " (торг)" : "";
        return parts.Count == 0
            ? (torg.Length > 0 ? "Ставка с торгом" : "Ставка без торга")
            : string.Join(" / ", parts) + torg;
    }

    private static string BoardDateText(AtiBoardCargo c)
    {
        if (c.DateType == "permanent") return "постоянно";
        if (c.DateType == "rate-request") return "груза нет, запрос ставки";

        var text = c.DateType == "ready" ? "готов к загрузке" : "";
        if (c.FirstDate == null) return text;

        var dates = c.FirstDate.Value.ToString("dd.MM");
        if (c.LastDate != null && c.LastDate != c.FirstDate)
        {
            dates += "–" + c.LastDate.Value.ToString("dd.MM");
        }

        return text.Length > 0 ? text + ", " + dates : dates;
    }

