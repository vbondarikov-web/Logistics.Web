private async Task LoadOrders()
{
    raw = "";
    orderRows.Clear();
    selectedOrder = null;

    var response = await Svc.SearchOrdersRawAsync();

    if (string.IsNullOrWhiteSpace(response))
    {
        throw new InvalidOperationException("ATI вернул пустое тело ответа.");
    }

    using var doc = JsonDocument.Parse(response);
    var root = doc.RootElement;

    if (root.ValueKind != JsonValueKind.Array)
    {
        throw new InvalidOperationException(
            "Неожиданный формат ответа ATI: ожидался массив заказов.");
    }

    foreach (var item in root.EnumerateArray())
    {
        var load = OrderField(item, "load_copy");
        var deal = OrderField(item, "deal");

        orderRows.Add(new AtiOrderRow(
            OrderText(load, "order_number")
                ?? OrderText(deal, "deal_id")
                ?? "—",
            OrderText(load, "load_number") ?? "—",
            $"{OrderPoint(OrderField(load, "loading"))} → " +
            OrderPoint(OrderField(load, "unloading")),
                OrderStatusLabel(OrderText(deal, "status")),
            OrderRates(deal)));
    }

    if (orderRows.Count == 0)
    {
        msg = "По текущему фильтру заказов нет.";
    }
}

private static JsonElement OrderField(JsonElement parent, string name)
{
    return parent.ValueKind == JsonValueKind.Object
        && parent.TryGetProperty(name, out var value)
        ? value
        : default;
}

